<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 基础身份：平台应用 + 免沙盒 -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.no-container</key>
	<true/>

	<!-- 剪贴板：无提示读写（这是整个方案的地基） -->
	<key>com.apple.private.webkit.pasteboard</key>
	<true/>
	<key>com.apple.private.pasteboard.check-pasteboard</key>
	<true/>
	<key>com.apple.Pasteboard.background-access</key>
	<true/>
	<key>com.apple.Pasteboard.paste-unchecked</key>
	<true/>

	<!-- 让进程能连上用户域的系统服务（pasteboardd 等） -->
	<key>com.apple.private.xpc.launchd.per-user-lookup</key>
	<true/>
</dict>
</plist>
